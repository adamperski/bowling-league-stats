# Generated outputs - rebuilt any time from data\raw\
/data/out/
/dashboard.html

# docs/index.html IS committed (GitHub Pages serves it). It's regenerated by
# Build-Stats.ps1, so expect it to show up in every "week of ..." commit.

# Keep, do NOT ignore:
#   data\raw\      - the snapshot archive
#   data\lineups\  - your manual sub/blind resolutions

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp

# Past seasons: lineups + lanes are GENERATED from the committed score sheets
# (scripts\Import-ScoreSheets.ps1 -Season <slug>); only the compact summary.json
# and the raw archive are kept.
/data/seasons/*/lineups/
/data/seasons/*/lanes.json
